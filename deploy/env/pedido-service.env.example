# Plantilla. El archivo real vive en /etc/tienda-musica/pedido-service.env (permisos 600) y NO se sube a Git.
# instalar_en_ec2.sh lo genera con contraseñas aleatorias.
PEDIDOS_DB_URL=jdbc:mysql://127.0.0.1:3306/tienda_musica_pedidos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PEDIDOS_DB_USER=pedidos_app
PEDIDOS_DB_PASSWORD=CLAVE_PEDIDOS
JWT_SECRET=SECRETO_JWT_COMPARTIDO
APP_CORS_ALLOWED_ORIGINS=http://IP_PUBLICA
PRODUCTO_URL=http://127.0.0.1:8083
METRICA_URL=http://127.0.0.1:8085
