# Plantilla. El archivo real vive en /etc/tienda-musica/usuario-service.env (permisos 600) y NO se sube a Git.
# instalar_en_ec2.sh lo genera con contraseñas aleatorias.
USUARIOS_DB_URL=jdbc:mysql://127.0.0.1:3306/tienda_musica_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
USUARIOS_DB_USER=usuarios_app
USUARIOS_DB_PASSWORD=CLAVE_USUARIOS
JWT_SECRET=SECRETO_JWT_COMPARTIDO
APP_CORS_ALLOWED_ORIGINS=http://IP_PUBLICA
