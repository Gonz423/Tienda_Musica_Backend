# Plantilla. El archivo real vive en /etc/tienda-musica/auth-service.env (permisos 600) y NO se sube a Git.
# instalar_en_ec2.sh lo genera con contraseñas aleatorias.
AUTH_DB_URL=jdbc:mysql://127.0.0.1:3306/tienda_musica_auth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=CLAVE_AUTH
JWT_SECRET=SECRETO_JWT_COMPARTIDO
APP_CORS_ALLOWED_ORIGINS=http://IP_PUBLICA
