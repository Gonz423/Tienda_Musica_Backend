# Plantilla. El archivo real vive en /etc/tienda-musica/metrica-service.env (permisos 600) y NO se sube a Git.
# instalar_en_ec2.sh lo genera con contraseñas aleatorias.
METRICAS_DB_URL=jdbc:mysql://127.0.0.1:3306/tienda_musica_metricas?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
METRICAS_DB_USER=metricas_app
METRICAS_DB_PASSWORD=CLAVE_METRICAS
JWT_SECRET=SECRETO_JWT_COMPARTIDO
APP_CORS_ALLOWED_ORIGINS=http://IP_PUBLICA
PEDIDO_URL=http://127.0.0.1:8084
PRODUCTO_URL=http://127.0.0.1:8083
