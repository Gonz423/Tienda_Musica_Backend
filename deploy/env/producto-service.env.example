# Plantilla. El archivo real vive en /etc/tienda-musica/producto-service.env (permisos 600) y NO se sube a Git.
# instalar_en_ec2.sh lo genera con contraseñas aleatorias.
PRODUCTOS_DB_URL=jdbc:mysql://127.0.0.1:3306/tienda_musica_productos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PRODUCTOS_DB_USER=productos_app
PRODUCTOS_DB_PASSWORD=CLAVE_PRODUCTOS
JWT_SECRET=SECRETO_JWT_COMPARTIDO
APP_CORS_ALLOWED_ORIGINS=http://IP_PUBLICA
