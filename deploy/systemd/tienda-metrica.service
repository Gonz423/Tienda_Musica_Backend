[Unit]
Description=Tienda Musica - metrica-service (puerto interno 8085)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=tiendamusica
Group=tiendamusica
WorkingDirectory=/opt/tienda-musica
# Variables y secretos fuera del código y de Git
EnvironmentFile=/etc/tienda-musica/metrica-service.env
ExecStart=/usr/bin/java -Xms64m -Xmx256m -XX:MaxMetaspaceSize=160m -XX:+UseSerialGC -Xss512k -jar /opt/tienda-musica/metrica-service.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=10
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
